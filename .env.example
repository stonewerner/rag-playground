# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated by src/lib/env.ts (schema: src/lib/env-schema.ts, P0-01).
# Uncommented keys are required; commented-out keys are optional. Check: pnpm env:check [group ...]

# --- Postgres on Supabase (docs/decisions/0003-postgres-and-drizzle.md) ---
# Runtime connection through the transaction pooler (port 6543). Used by the app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct/session connection (port 5432). Used only by drizzle-kit migrations and scripts.
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Blob storage: Cloudflare R2 via its S3 API (docs/decisions/0004-blob-storage.md) ---
# R2 API token with Object Read & Write on this bucket only.
BLOB_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BLOB_S3_REGION=auto
BLOB_S3_BUCKET=rag-playground
BLOB_S3_ACCESS_KEY_ID=
BLOB_S3_SECRET_ACCESS_KEY=

# --- Pinecone (Documents API, 2026-07; see docs/decisions/0005-pinecone-indexes.md) ---
PINECONE_API_KEY=
PINECONE_DENSE_INDEX=rag-playground-dense
PINECONE_SPARSE_INDEX=rag-playground-sparse
# Hosted reranker. bge-reranker-v2-m3 is the only one on Starter/Builder plans.
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
# Sparse model used by the sparse index's sparse_embed field.
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0

# --- OpenAI (embeddings now; generation/judge in Phase 3) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Guest sessions ---
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_COOKIE_SECRET=
GUEST_SESSION_TTL_HOURS=72

# --- Cron / admin ---
# Vercel sends this as a Bearer token to cron routes. Generate: openssl rand -hex 32
CRON_SECRET=

# --- SEC EDGAR (scripts only) ---
# SEC requires a descriptive User-Agent with contact info: "<Name or org> <email>".
SEC_USER_AGENT="RAG Playground (portfolio project) you@example.com"

# --- Cost guardrails (defaults live in code; override here) ---
# CAP_MAX_FILE_BYTES=1000000
# CAP_MAX_DOCS_PER_SESSION=10
# CAP_MAX_INDEX_CONFIGS_PER_SESSION=3
# CAP_MAX_EMBED_TOKENS_PER_SESSION=400000
# CAP_QUERIES_PER_MINUTE=20
# CAP_RERANKS_PER_SESSION_PER_DAY=50
# CAP_GLOBAL_GUEST_NAMESPACES=80
